# Supabase — pegar em app.supabase.com > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...          # chave pública (vai no frontend também)
SUPABASE_SERVICE_KEY=eyJ...       # chave privada, NUNCA expor no frontend

# Mercado Pago — pegar em mercadopago.com.br > Suas Integrações > Credenciais
MP_ACCESS_TOKEN=APP_USR-...       # Produção (TEST-... para sandbox)
MP_PUBLIC_KEY=APP_USR-...         # Chave pública para o Bricks (TEST-... para sandbox)
MP_WEBHOOK_SECRET=...             # Configurar em MP > Notificações IPN

# Upstash Redis — pegar em console.upstash.com
UPSTASH_REDIS_URL=https://....upstash.io
UPSTASH_REDIS_TOKEN=...

# Resend — pegar em resend.com > API Keys
RESEND_API_KEY=re_...
FROM_EMAIL=contato@arquivo90.com.br   # remetente dos emails transacionais

# Admin
ADMIN_EMAIL=seu@email.com         # único email autorizado no painel admin

# Site
SITE_URL=https://arquivo90.com.br

# Cron — segredo para proteger o endpoint /api/cron
CRON_SECRET=gere_uma_string_aleatoria_forte
